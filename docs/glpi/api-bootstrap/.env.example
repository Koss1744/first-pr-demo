# Пример окружения для bootstrap.py / rollback.py.
# Скопируйте в .env, заполните РЕАЛЬНЫМИ значениями на машине администратора
# и НЕ коммитьте: .env добавлен в .gitignore этого каталога.
#
#   set -a; . ./.env; set +a
#   python3 bootstrap.py --confirm sd.hofi.su --steps all
#
# Ни один секрет не должен попадать в аргументы командной строки: аргументы
# видны в `ps` другим пользователям сервера и оседают в ~/.bash_history.

# Точка входа REST API. Для GLPI 10.x это /apirest.php.
# Инстанс доступен только из локальной сети заказчика.
GLPI_URL=https://sd.hofi.su/apirest.php

# App-Token: Настройка -> Основная конфигурация -> вкладка «API» ->
# «Добавить клиента API». Там же включается сам REST API и задаётся
# список разрешённых IP — с рабочей станции администратора он должен быть виден.
GLPI_APP_TOKEN=<APP_TOKEN>

# Персональный токен учётной записи: Администрирование -> Пользователи ->
# <ваша учётка> -> вкладка «Основное» -> «Ключ API» -> «Сгенерировать».
# Предпочтительнее логина с паролем: токен отзывается одной кнопкой.
GLPI_USER_TOKEN=<USER_TOKEN>

# Альтернатива токену (если политика запрещает персональные токены).
# Оставьте пустыми, если используется GLPI_USER_TOKEN.
#GLPI_LOGIN=<LOGIN>
#GLPI_PASSWORD=<PASSWORD>

# Необязательно: путь к корневому сертификату, если у инстанса внутренний УЦ.
# Отключать проверку TLS нельзя — вместо этого добавьте сертификат УЦ.
#GLPI_CA_BUNDLE=/etc/ssl/certs/hofi-root-ca.pem
