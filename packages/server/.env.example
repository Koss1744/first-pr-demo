# Copy to .env (or export these in your process manager / systemd unit).
# Never commit a real .env file - it's gitignored.

HOFI_SERVER_PORT=3000
HOFI_DATABASE_URL=postgres://hofi:CHANGE_ME@localhost:5432/hofi

# Generate with: openssl rand -base64 32
# Add HOFI_ROOT_KEY_V2 etc. and bump HOFI_ROOT_KEY_ACTIVE_VERSION to rotate.
HOFI_ROOT_KEY_V1=CHANGE_ME_32_RANDOM_BYTES_BASE64
HOFI_ROOT_KEY_ACTIVE_VERSION=1

# "ldap" for production (Active Directory), "memory" for local dev only
# (the in-memory directory has no users unless seeded in code - it exists
# for tests, not as a real dev-mode identity source).
HOFI_DIRECTORY_IMPL=ldap
HOFI_LDAP_URL=ldaps://dc1.example.internal:636
HOFI_LDAP_BIND_DN=CN=hofi-svc,OU=ServiceAccounts,DC=example,DC=internal
HOFI_LDAP_BIND_PASSWORD=CHANGE_ME
HOFI_LDAP_BASE_DN=DC=example,DC=internal
# {username} is substituted with the RFC 4515-escaped lookup value.
HOFI_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))

HOFI_MAX_FAILED_ATTEMPTS=5
HOFI_LOCKOUT_DURATION_MS=900000
HOFI_TOTP_DRIFT_STEPS=1
